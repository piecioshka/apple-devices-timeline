{
  "name": "apple-devices-timeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port $(detect-port 3000)",
    "build": "astro build",
    "preview": "astro preview --port $(detect-port 3000)",
    "start": "npm run preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og": "rsvg-convert -w 1200 -h 630 assets/og/og-en.svg -o public/og-en.png && rsvg-convert -w 1200 -h 630 assets/og/og-pl.svg -o public/og-pl.png",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "detect-port": "^2.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "description": "Timeline of every device Apple announced since 2008, newest first.",
  "license": "MIT",
  "author": {
    "name": "Piotr Kowalski",
    "email": "piecioshka@gmail.com",
    "url": "https://piecioshka.pl/"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/piecioshka/apple-devices-timeline.git"
  },
  "keywords": [
    "apple",
    "timeline",
    "devices",
    "astro"
  ],
  "dependencies": {
    "astro": "^7.3.2"
  }
}
