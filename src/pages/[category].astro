---
import Base from '@/layouts/Base.astro';
import TimelinePage from '@/components/TimelinePage.astro';
import { UI } from '@/i18n/ui';
import { CATEGORY_SLUGS, isCategorySlug } from '@/lib/categories';

export function getStaticPaths() {
  return CATEGORY_SLUGS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
if (!isCategorySlug(category)) {
  throw new Error(`Unknown category: ${category}`);
}
---

<Base locale="en" title={UI.en.categories[category]}>
  <TimelinePage locale="en" filter={category} />
</Base>
