---
import { thumbnailMarkup, type ThumbnailKey } from '@/lib/thumbnails';

interface Props {
  thumbnail: ThumbnailKey;
  /** Rendered width and height in CSS pixels. */
  size?: number;
}

const { thumbnail, size = 40 } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <Fragment set:html={thumbnailMarkup(thumbnail)} />
</svg>

<style>
  .icon {
    display: block;
    margin-top: 0.125rem;
    color: var(--muted);
  }

  .icon :global(.accent) {
    stroke: var(--accent);
  }

  .icon :global(.fill) {
    fill: currentColor;
  }

  .icon :global(.accent.fill) {
    fill: var(--accent);
    stroke: none;
  }
</style>
