---
import type { Device } from '@/data/devices';
import { UI, type Locale } from '@/i18n/ui';
import Pictogram from './Pictogram.astro';

interface Props {
  locale: Locale;
  device: Device;
}

const { locale, device } = Astro.props;
---

<article id={device.id} class="card">
  <Pictogram thumbnail={device.thumbnail} />
  <div class="body">
    <p class="category">{UI[locale].categories[device.category]}</p>
    <h4 class="name">{device.name}</h4>
    <p class="highlight">{device.highlight[locale]}</p>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    height: 100%;
    padding: 0.875rem 1rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    scroll-margin-top: calc(var(--toolbar-height) + 1rem);
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .category {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    margin-top: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .highlight {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
