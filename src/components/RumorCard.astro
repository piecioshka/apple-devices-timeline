---
import type { Rumor } from '@/data/rumors';
import { UI, type Locale } from '@/i18n/ui';
import Pictogram from './Pictogram.astro';

interface Props {
  locale: Locale;
  rumor: Rumor;
}

const { locale, rumor } = Astro.props;
const ui = UI[locale];
---

<!--
  A <div>, not an <article>: the ItemList structured data and the tests count
  <article> elements as announced devices, and a rumor is not one.
-->
<div class="card">
  <Pictogram thumbnail={rumor.thumbnail} />
  <div class="body">
    <p class="category">{ui.categories[rumor.category]}</p>
    <h4 class="name">{rumor.name}</h4>
    <p class="summary">{rumor.summary[locale]}</p>
    <p class="sources">
      <span class="sources-label">{ui.sources}:</span>{' '}
      {rumor.sources.join(', ')}
    </p>
  </div>
</div>

<style>
  .card {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    height: 100%;
    padding: 0.875rem 1rem 1rem;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .category {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    margin-top: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .summary {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .sources {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .sources-label {
    font-weight: 600;
  }
</style>
