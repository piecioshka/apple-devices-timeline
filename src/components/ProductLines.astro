---
import type { Device } from '@/data/devices';
import { UI, plural, type Locale } from '@/i18n/ui';
import {
  groupLinesByCategory,
  summarizeLines,
  type ProductLineSummary,
} from '@/lib/lines';
import { announcementYear } from '@/lib/timeline';
import Pictogram from './Pictogram.astro';

interface Props {
  locale: Locale;
  /** Devices shown on the page, already filtered by category. */
  devices: Device[];
  /** Split the lines by category, for the page that lists every category. */
  byCategory?: boolean;
}

const { locale, devices, byCategory = false } = Astro.props;
const ui = UI[locale];
const lines = summarizeLines(devices);
const groups = byCategory
  ? groupLinesByCategory(lines).map((group) => ({
      heading: ui.categories[group.category],
      lines: group.lines,
    }))
  : [{ heading: undefined, lines }];

function years(line: ProductLineSummary): string {
  return line.firstYear === line.lastYear
    ? String(line.firstYear)
    : `${line.firstYear}-${line.lastYear}`;
}
---

<section id="lines" class="lines" aria-labelledby="lines-title">
  <div class="rail">
    <h2 id="lines-title" class="heading">
      {ui.linesTitle}
    </h2>
    <p class="count">
      {lines.length} {plural(locale, lines.length, ui.lines)}
    </p>
  </div>

  <div class="content">
    <p class="intro">{ui.linesIntro}</p>
    {groups.map((group) => (
      <div class="group">
        {group.heading && <h3 class="group-heading">{group.heading}</h3>}
        <ul class="list">
          {group.lines.map((line) => (
            <li>
              <details class="line">
                <summary class="summary">
                  <Pictogram thumbnail={line.thumbnail} size={28} />
                  <span class="name">{line.line}</span>
                  <span class="meta">
                    {line.devices.length}{' '}
                    {plural(locale, line.devices.length, ui.models)} ·{' '}
                    {years(line)}
                  </span>
                  <svg
                    class="chevron"
                    viewBox="0 0 16 16"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </summary>
                <ol class="models">
                  {line.devices.map((device) => (
                    <li class="model">
                      <a href={`#${device.id}`} class="model-link">
                        {device.name}
                      </a>
                      <span class="model-year">{announcementYear(device)}</span>
                    </li>
                  ))}
                </ol>
              </details>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .lines {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--toolbar-height) + 1rem);
  }

  .rail {
    position: sticky;
    top: calc(var(--toolbar-height) + 1.25rem);
    align-self: start;
  }

  .heading {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 80;
  }

  .count {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .intro {
    max-width: 60ch;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .group {
    margin-top: 1.5rem;
  }

  .group + .group {
    margin-top: 2.25rem;
  }

  .group-heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .line {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 120ms ease;
  }

  .line:hover,
  .line[open] {
    border-color: var(--line-strong);
  }

  .summary {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }

  .summary::-webkit-details-marker {
    display: none;
  }

  .name {
    font-weight: 600;
    line-height: 1.3;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .chevron {
    color: var(--muted);
    transform-origin: center;
    transition: transform 120ms ease;
  }

  .line[open] .chevron {
    transform: rotate(180deg);
  }

  .models {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.125rem 0.875rem 0.875rem calc(1.75rem + 0.75rem + 0.875rem);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .model {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .model-link {
    border-bottom: 1px solid transparent;
    transition: border-color 120ms ease;
  }

  .model-link:hover {
    border-color: var(--accent);
  }

  .model-year {
    flex-shrink: 0;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .lines {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .rail {
      top: var(--toolbar-height);
      z-index: 1;
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.5rem 0;
      background: var(--bg);
    }

    .heading {
      font-size: 1.75rem;
    }

    .count {
      margin-top: 0;
    }
  }
</style>
