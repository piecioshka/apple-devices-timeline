---
import { UI, localePath, type Locale } from '@/i18n/ui';
import { CATEGORY_SLUGS, type CategoryFilter } from '@/lib/categories';

interface Props {
  locale: Locale;
  active: CategoryFilter;
}

const { locale, active } = Astro.props;
const ui = UI[locale];
const entries = [
  { href: localePath(locale, '/'), slug: 'all', label: ui.all },
  ...CATEGORY_SLUGS.map((slug) => ({
    href: localePath(locale, `/${slug}`),
    slug,
    label: ui.categories[slug],
  })),
];
---

<nav aria-label={ui.categoriesLabel} class="nav">
  <ul class="list">
    {entries.map((entry) => (
      <li>
        <a
          href={entry.href}
          class="chip"
          aria-current={active === entry.slug ? 'page' : undefined}
        >
          {entry.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    min-width: 0;
    width: 100%;
  }

  .list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    /* Room for the focus ring inside the scroll container. */
    padding: 3px;
    margin: -3px;
  }

  .list::-webkit-scrollbar {
    display: none;
  }

  .chip {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
</style>
